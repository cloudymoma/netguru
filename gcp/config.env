# shellcheck shell=bash
# netguru configuration — single source of truth. See spec §4.1.

# GCP (env overrides allowed, e.g. GCP_PROJECT=other make all)
GCP_PROJECT="${GCP_PROJECT:-du-hast-mich}"
GCP_REGION="asia-northeast1"
GCP_ZONE="asia-northeast1-a"

# VM (creation parameters apply only when the VM does not exist yet)
VM_NAME="outline-server"
VM_MACHINE_TYPE="e2-small"
VM_DISK_SIZE="10GB"
VM_IMAGE_FAMILY="debian-12"
VM_IMAGE_PROJECT="debian-cloud"
NETWORK_NAME="default"
NETWORK_TAG="outline-server"
STATIC_IP_NAME="outline-tokyo-ip"

# Firewall
IAP_SOURCE_RANGE="35.235.240.0/20"
FW_ALLOW_PRIORITY="800"
FW_DENY_PRIORITY="900"
FW_SSH_IAP="outline-server-ssh-iap"
FW_DENY_ALL="outline-server-deny-all"
FW_LEGACY_OUTLINE_API="outline-server-api"

# Enabled services, deployed in this order
SERVICES="outline sing-box"

# Outline
OUTLINE_API_PORT="39247"
OUTLINE_KEYS_PORT="44923"
OUTLINE_INSTALLER_URL="https://raw.githubusercontent.com/Jigsaw-Code/outline-apps/01403ec3993a60f3034d7437aafe273a55349e6a/server_manager/install_scripts/install_server.sh"
OUTLINE_INSTALLER_SHA256="e7594b713d19b365765690624afbabe3c97ab96eb377d43630fc3c6a27d5b986"
OUTLINE_IMAGE_REPO="quay.io/outline/shadowbox"
OUTLINE_IMAGE_TAG="stable" # resolved to a digest on the workstation at install/upgrade time

# sing-box
SINGBOX_VERSION="latest" # latest stable at install/upgrade time; or X.Y.Z to pin
SINGBOX_GPG_FINGERPRINT="2C317FBD5D886B4E89BAE8DA6D9152172A2B2F0C"
SINGBOX_REALITY_PORT="443"
SINGBOX_REALITY_SNI="www.yahoo.co.jp"
SINGBOX_HY2_PORT="8443"
SINGBOX_HY2_SNI="${SINGBOX_REALITY_SNI}"
SINGBOX_ENABLE_BBR="true"
