# shellcheck shell=bash
# sing-box module contract (spec §4.6). Sourced by gcp/lib.sh:load_service.
FW_RULES="tcp:${SINGBOX_REALITY_PORT},udp:${SINGBOX_HY2_PORT}"
REMOTE_VARS="SINGBOX_VERSION SINGBOX_TARGET_VERSION SINGBOX_GPG_FINGERPRINT SINGBOX_REALITY_PORT SINGBOX_REALITY_SNI SINGBOX_HY2_PORT SINGBOX_HY2_SNI SINGBOX_HY2_SALAMANDER SINGBOX_ENABLE_BBR SINGBOX_LOG_ENABLED SINGBOX_LOG_LEVEL"
SINGBOX_TARGET_VERSION="" # set by service_prepare

service_validate() {
  [[ "${SINGBOX_VERSION}" == latest || "${SINGBOX_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    die "SINGBOX_VERSION must be 'latest' or X.Y.Z (got '${SINGBOX_VERSION}')"
  require_gpg_fpr SINGBOX_GPG_FINGERPRINT "${SINGBOX_GPG_FINGERPRINT}"
  require_port SINGBOX_REALITY_PORT "${SINGBOX_REALITY_PORT}"
  require_port SINGBOX_HY2_PORT "${SINGBOX_HY2_PORT}"
  require_hostname SINGBOX_REALITY_SNI "${SINGBOX_REALITY_SNI}"
  require_hostname SINGBOX_HY2_SNI "${SINGBOX_HY2_SNI}"
  require_bool SINGBOX_HY2_SALAMANDER "${SINGBOX_HY2_SALAMANDER}"
  require_bool SINGBOX_ENABLE_BBR "${SINGBOX_ENABLE_BBR}"
  require_bool SINGBOX_LOG_ENABLED "${SINGBOX_LOG_ENABLED}"
  [[ "${SINGBOX_LOG_LEVEL}" =~ ^(trace|debug|info|warn|error|fatal|panic)$ ]] ||
    die "SINGBOX_LOG_LEVEL must be one of trace debug info warn error fatal panic (got '${SINGBOX_LOG_LEVEL}')"
}

# Resolve the target version on the workstation; the VM installs only this version (spec §4.10).
service_prepare() {
  if [[ "${SINGBOX_VERSION}" == latest ]]; then
    SINGBOX_TARGET_VERSION=$(github_latest_version SagerNet/sing-box)
  else
    SINGBOX_TARGET_VERSION=${SINGBOX_VERSION}
  fi
  log "sing-box target version: ${SINGBOX_TARGET_VERSION}"
}
