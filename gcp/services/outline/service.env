# shellcheck shell=bash
# Outline module contract (spec §4.5). Sourced by gcp/lib.sh:load_service.
FW_RULE_NAME="outline-server-access"
FW_RULES="tcp:${OUTLINE_KEYS_PORT},udp:${OUTLINE_KEYS_PORT}"
REMOTE_VARS="OUTLINE_API_PORT OUTLINE_KEYS_PORT OUTLINE_INSTALLER_URL OUTLINE_INSTALLER_SHA256 OUTLINE_IMAGE_REPO OUTLINE_IMAGE_TAG OUTLINE_IMAGE_DIGEST"
OUTLINE_IMAGE_DIGEST="" # set by service_prepare

service_validate() {
  require_port OUTLINE_API_PORT "${OUTLINE_API_PORT}"
  require_port OUTLINE_KEYS_PORT "${OUTLINE_KEYS_PORT}"
  require_not_tbd OUTLINE_INSTALLER_URL "${OUTLINE_INSTALLER_URL}"
  [[ "${OUTLINE_INSTALLER_URL}" == https://raw.githubusercontent.com/Jigsaw-Code/* ]] ||
    die "OUTLINE_INSTALLER_URL must be a raw.githubusercontent.com/Jigsaw-Code URL (got '${OUTLINE_INSTALLER_URL}')"
  require_sha256 OUTLINE_INSTALLER_SHA256 "${OUTLINE_INSTALLER_SHA256}"
  [[ "${OUTLINE_IMAGE_REPO}" =~ ^quay\.io/[a-z0-9._-]+/[a-z0-9._-]+$ ]] ||
    die "OUTLINE_IMAGE_REPO must be quay.io/<namespace>/<repo> (got '${OUTLINE_IMAGE_REPO}')"
  [[ "${OUTLINE_IMAGE_TAG}" =~ ^[A-Za-z0-9._-]+$ ]] || die "OUTLINE_IMAGE_TAG is invalid (got '${OUTLINE_IMAGE_TAG}')"
}

# Resolve the image digest on the workstation; the VM pulls exactly this digest (spec §4.10).
service_prepare() {
  OUTLINE_IMAGE_DIGEST=$(quay_tag_digest "${OUTLINE_IMAGE_REPO}" "${OUTLINE_IMAGE_TAG}")
  log "outline target image: ${OUTLINE_IMAGE_REPO}@${OUTLINE_IMAGE_DIGEST}"
}
